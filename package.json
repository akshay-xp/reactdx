{
  "name": "reactdx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @reactdx/extension build",
    "typecheck": "tsc -p . && tsc -p packages/panel && tsc -p apps/extension",
    "lint": "biome check --error-on-warnings",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm check:bundles",
    "check:bundles": "node scripts/check/run.ts",
    "test": "pnpm test:unit && pnpm test:check && pnpm -r test",
    "test:unit": "vitest run",
    "test:check": "node --test \"scripts/check/*.test.ts\"",
    "test:fixtures": "node --test fixtures/fixtures.test.ts",
    "fixture:18": "pnpm -C fixtures/vite exec vite --mode 18 --port 5218 --strictPort",
    "fixture:19": "pnpm -C fixtures/vite exec vite --mode 19 --port 5219 --strictPort",
    "fixture:next": "NEXT_TELEMETRY_DISABLED=1 pnpm -C fixtures/next exec next dev --port 5220",
    "fixture:multi": "node fixtures/multi/serve.ts",
    "test:e2e": "node e2e/run.ts",
    "bench:hook-cost": "pnpm --filter @reactdx/bench-hook-cost bench",
    "rdt:update": "node e2e/rdt-update.ts",
    "icons": "node scripts/icons.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "puppeteer": "25.17.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
