{
  "manifest_version": 3,
  "name": "ReactDX timing (registered)",
  "version": "0.0.0",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "timing-registered@reactdx.spike"
    }
  }
}
